; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unknown Horizons Godot"
run/main_scene="res://scenes/poc_main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/boot_splash/bg_color=Color(0.117647, 0.117647, 0.117647, 1)
config/boot_splash/show_image=true
config/boot_splash/fullsize=false
config/boot_splash/use_filter=true
config/boot_splash/minimum_display_time=1.5

[autoload]

GameConstants="*res://scripts/autoload/game_constants.gd"
DlcConstants="*res://scripts/autoload/dlc_constants.gd"
MessageBus="*res://scripts/sim/message_bus.gd"
BuildingVisualRegistry="*res://scripts/view/building_visual_registry.gd"
ContentTheme="*res://scripts/autoload/content_theme.gd"
ResourceIconRegistry="*res://scripts/view/resource_icon_registry.gd"
GameAudioService="*res://scripts/view/audio/game_audio_service.gd"

[filesystem]

import/blender/enabled=false

[rendering]

textures/canvas_textures/default_texture_filter=0
