{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UH parity scenario v1",
  "type": "object",
  "required": ["id", "map", "steps"],
  "properties": {
    "id": { "type": "string" },
    "map": { "type": "string", "enum": ["test_island_20x20", "development"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "enum": [
              "settle",
              "build",
              "build_ownerless",
              "build_farm",
              "alter_storage",
              "alter_storage_at",
              "run_ticks",
              "run_seconds",
              "toggle_producer",
              "snapshot_roundtrip",
              "finish_production",
              "load_fixture"
            ]
          },
          "building": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "target": { "type": "string", "enum": ["settlement", "building"] },
          "stem": { "type": "string" },
          "resource": { "type": "string" },
          "amount": { "type": "integer" },
          "ticks": { "type": "integer" },
          "seconds": { "type": "number" },
          "active": { "type": "boolean" },
          "fields": { "type": "array", "items": { "type": "string" } },
          "path": { "type": "string" }
        }
      }
    },
    "expect": {
      "type": "object",
      "properties": {
        "min_settlement": { "type": "object" },
        "min_building_storage": {
          "type": "object",
          "properties": {
            "stem": { "type": "string" },
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "resource": { "type": "string" },
            "min": { "type": "integer" }
          }
        }
      }
    }
  }
}
